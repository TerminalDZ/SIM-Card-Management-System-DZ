################################################################################
# SIM Card Management System - Environment Configuration
# Copy this file to `.env` and adjust values as needed.
################################################################################

# --- HTTP API ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
APP_RELOAD=false

# --- API Metadata ---
APP_TITLE=SIM Card Management System
APP_VERSION=3.0.0
APP_DESCRIPTION=Professional multi-modem SIM card management API

# --- Logging ---
APP_LOG_LEVEL=INFO
APP_LOG_FILE=logs/sim_manager.log
APP_LOG_MAX_BYTES=10485760
APP_LOG_BACKUP_COUNT=5
APP_LOG_JSON=false

# --- Modem hardware ---
APP_MODEM_BAUDRATE=115200
APP_MODEM_OPEN_TIMEOUT=2.0
APP_MODEM_READ_TIMEOUT=10.0
APP_MODEM_COMMAND_RETRIES=2
APP_MODEM_DEFAULT_APN=internet
APP_MAX_CONCURRENT_MODEMS=10
APP_AUTO_DETECT_ON_STARTUP=true

# --- Operator data ---
APP_OPERATORS_FILE=data/operators.json

# --- WebSocket ---
APP_WS_HEARTBEAT_INTERVAL=30
APP_WS_BROADCAST_INTERVAL=15

# --- CORS (JSON list, * means open) ---
APP_CORS_ORIGINS=["*"]
APP_CORS_ALLOW_CREDENTIALS=true
